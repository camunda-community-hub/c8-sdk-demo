    <bpmn:sequenceFlow id="Flow_1jcaxwg" name="True" sourceRef="Gateway_1w1kik2" targetRef="Activity_0ysbhdw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isAutomatible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1igd0uy" sourceRef="Activity_0ysbhdw" targetRef="Activity_0968bde" />
