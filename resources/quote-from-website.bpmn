      <bpmn:extensionElements>
        <zeebe:taskDefinition type="triage-automatibility" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ajuc1b</bpmn:incoming>
      <bpmn:outgoing>Flow_1vxmxpi</bpmn:outgoing>
    </bpmn:serviceTask>
