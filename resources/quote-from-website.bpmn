      <bpmn:outgoing>Flow_0ajuc1b</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0ajuc1b" sourceRef="StartEvent_1" targetRef="Activity_0od3819" />
